{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Apple Points",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.11,
          0.118
        ],
        "hex": "#1a1c1e"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 8,
        "unit": "pt"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "md": {
      "$value": {
        "value": 12,
        "unit": "pt"
      }
    }
  },
  "typography": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "SF Pro",
        "fontSize": {
          "value": 17,
          "unit": "pt"
        },
        "fontWeight": 400
      }
    }
  }
}
